# Copy this file to .env and fill in your own key. Never commit .env itself.

# Required for the real conversational concierge. Without this, the server
# still runs and the matching engine still works, but /api/chat returns a
# demo-mode message instead of an actual model reply.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-5-20250929 if not set.
ANTHROPIC_MODEL=

# Optional — defaults to 3000.
PORT=
