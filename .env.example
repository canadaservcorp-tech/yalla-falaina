PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=            # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=        # optional in dev (emails print to console if empty)
MAIL_FROM=TrouvePro <onboarding@resend.dev>
# RBQ outreach campaign (scripts/send-outreach.js) — CASL requires the postal address in every message
OUTREACH_POSTAL_ADDRESS=   # e.g. 309-1355 Boul. Le Corbusier, Laval, QC H7N 0G4
OUTREACH_REPLY_TO=contact@mytrouvepro.net
PAYWALL_ENFORCED=false # false = show all providers now; true = only subscribed appear

# Phase 2 — PayPal provider subscription ($15 for 3 months, then $10/month)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=        # billing plan created with scripts/paypal-setup.js
PAYPAL_WEBHOOK_ID=     # webhook created with scripts/paypal-setup.js
PAYPAL_BOOST_PLAN_ID=  # auto-renewing top-placement plan, scripts/paypal-boost-setup.js
PAYPAL_ENV=live        # live | sandbox

# Phase 3 — image moderation (unset = photo uploads are refused)
GOOGLE_VISION_API_KEY=
ALLOW_UNMODERATED_PHOTOS=false # true = accept photos with no moderation (dev only)
JOBS=on
