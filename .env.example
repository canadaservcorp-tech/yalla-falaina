PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=            # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPABASE_URL=          # NEW Supabase project for Yalla Nsafer — never trouvepro's
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=        # optional in dev (emails print to console if empty)
MAIL_FROM=Yalla Nsafer <onboarding@resend.dev>
CONTACT_EMAIL=         # inbox for the public Contact Us form
NOTIFY_EMAIL=          # optional: inbox for new-signup notifications (falls back to CONTACT_EMAIL)
PAYWALL_ENFORCED=false # true = concierge requires an active subscription
GA_MEASUREMENT_ID=     # optional Google Analytics 4 id (G-XXXXXXXXXX); empty = no analytics
FREE_PREVIEW_LIMIT=    # free concierge replies before the paywall/preview mode kicks in; empty defaults to 8
DOCUMENTS_BUCKET=documents # Supabase Storage bucket for document_uploads (CVs, voice notes, screenshots) -- scripts/document-retention.js and lib/voiceNotes.js both read this

# Concierge model (Anthropic). Without a key the chat runs in demo mode:
# matching still works, the reply is the raw shortlist instead of a model answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=       # optional, defaults to a current Claude Sonnet model

# Chat voice notes: recorded in-page, transcribed to text, sent through the
# concierge like a typed turn. The button only appears when these are set
# (/api/health surfaces `voice`). The endpoint shape is OpenAI-compatible, so
# STT_BASE_URL can point at Groq's or another provider's identical API.
STT_API_KEY=           # OpenAI key with audio access — the concierge itself cannot hear audio
STT_MODEL=             # optional, defaults to whisper-1
STT_BASE_URL=          # optional, defaults to https://api.openai.com/v1

# "Continue with Google" (routes/auth.js /google/*). Create an OAuth 2.0 Web
# client at console.cloud.google.com and add PUBLIC_URL + /api/auth/google/callback
# as an authorized redirect URI. Unset = the button never renders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Licensed job feed (Section 6.1 — never scraped). 'seed' imports the handoff
# bundle's data/jobs.json so the concierge is testable before provider approval.
JOB_API_PROVIDER=seed  # 'adzuna' | 'jooble' | 'seed'
JOB_API_ID=            # Adzuna: app_id
JOB_API_KEY=           # Adzuna: app_key | Jooble: API key
JOB_API_COUNTRY=ca     # Adzuna country code (single-country deploys)
JOB_API_COUNTRIES=     # Adzuna: comma-separated codes, e.g. "ca,fr,de,ae,sa" -- takes priority over JOB_API_COUNTRY when set
JOB_API_KEYWORDS=      # Jooble query terms
JOB_API_LOCATION=      # Jooble location (single-location deploys)
JOB_API_LOCATIONS=     # Jooble: comma-separated locations, e.g. "United Arab Emirates,Saudi Arabia,France" -- takes priority over JOB_API_LOCATION when set

# PayPal seeker subscription — $25/month "Basic" (scripts/paypal-setup.js)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=live        # live | sandbox

# Stripe — second rail for the same $25/month "Basic" tier, specifically to
# reach subscribers PayPal's own country list excludes (Iraq, Lebanon — see
# CLAUDE_PROMPT.md's payments section). Runs alongside PayPal, not instead of
# it. No sandbox/live toggle needed: which mode you're in is just which kind
# of secret key (sk_test_... vs sk_live_...) you put here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=       # the recurring $25/month Price id, created in the Stripe Dashboard (Product catalog)

JOBS=on                # 'off' disables the in-process scheduled jobs

# Emergency controls — leave both unset in normal operation, where they cost
# nothing. See SECURITY-INCIDENT-RESPONSE.md for when and how to use them.
AUTH_MIN_ISSUED_AT=    # set to an ISO timestamp to instantly invalidate every JWT issued before it, everywhere
SITE_LOCKDOWN=         # set to 'true' to take every /api route offline except /api/health
