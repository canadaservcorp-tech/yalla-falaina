PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=            # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPABASE_URL=          # NEW Supabase project for Yalla Falaina — never trouvepro's
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=        # optional in dev (emails print to console if empty)
MAIL_FROM=Yalla Falaina <onboarding@resend.dev>
PAYWALL_ENFORCED=false # true = concierge requires an active subscription
GA_MEASUREMENT_ID=     # optional Google Analytics 4 id (G-XXXXXXXXXX); empty = no analytics

# Concierge model (Anthropic). Without a key the chat runs in demo mode:
# matching still works, the reply is the raw shortlist instead of a model answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=       # optional, defaults to a current Claude Sonnet model

# Licensed job feed (Section 6.1 — never scraped). 'seed' imports the handoff
# bundle's data/jobs.json so the concierge is testable before provider approval.
JOB_API_PROVIDER=seed  # 'adzuna' | 'jooble' | 'seed'
JOB_API_ID=            # Adzuna: app_id
JOB_API_KEY=           # Adzuna: app_key | Jooble: API key
JOB_API_COUNTRY=ca     # Adzuna country code
JOB_API_KEYWORDS=      # Jooble query terms
JOB_API_LOCATION=      # Jooble location

# PayPal seeker subscription — $25/month "Basic" (scripts/paypal-setup.js)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=live        # live | sandbox

JOBS=on                # 'off' disables the in-process scheduled jobs
